# Hardhat / CBDC Backend environment variables
# Copy this file to .env and fill in your values

# Local Hardhat node (default — no change needed for local dev)
RPC_URL=http://127.0.0.1:8545

# Paste the private key of the deployer account here (Hardhat account #0 shown below for local dev)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Filled automatically after `make deploy-contracts` — paste the deployed address here
CONTRACT_ADDRESS=
